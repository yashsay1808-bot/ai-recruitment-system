# =====================================================================
# AI Recruitment Platform (Phase 4) - Environment Variables
# =====================================================================

# Environment mode: development | testing | production
ENVIRONMENT=development
DEBUG=true

# Database Configuration (Postgres with pgvector via Docker Compose)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/recruitment_db

# LLM & Embedding Configuration
# LLM_PROVIDER options: 'mock' (default offline provider for testing without keys) or 'gemini'
LLM_PROVIDER=mock
LLM_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=text-embedding-004

# Google Gemini API Key (Required only if LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# MongoDB Atlas (accounts, sessions, candidate pools). Leave empty to disable the Mongo routes.
# Never commit the real value; set it in Render's dashboard.
MONGODB_URI=
MONGODB_DB=recruitment

# Security
SECRET_KEY=change-this-in-production-to-a-secure-random-string

# API & CORS Settings
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Forgot-password e-mails (Brevo HTTPS API) and optional SMS (Twilio). Leave empty to switch them off.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Nexus ATS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Alternative to Brevo: Google Apps Script relay (docs/gmail-relay.gs). Sends from the script owner's Gmail.
MAIL_RELAY_URL=
MAIL_RELAY_SECRET=
