# Copy to `.env` (never commit it). Every value is optional: with no .env the app is fully
# self-contained (accounts stored in this browser, bundled sample candidates).

# Backend that fronts MongoDB Atlas, GitHub and Gmail/SMTP, e.g. http://localhost:8000
VITE_API_BASE_URL=

# local | api   -> api uses POST /auth/signup, /auth/signin, GET /auth/me, POST /auth/signout
VITE_AUTH_PROVIDER=local

# local | api   -> api uses GET /candidates?pool=<core12|benchmark50|benchmark100>
VITE_CANDIDATES_PROVIDER=local

# Google OAuth Web client id (public). When set, Google is the ONLY sign-in method.
VITE_GOOGLE_CLIENT_ID=

# Public GitHub OAuth client id (the secret and token exchange belong on the backend)
VITE_GITHUB_CLIENT_ID=

# off | api     -> api sends interview invites via POST /integrations/mail/invite
VITE_MAIL_PROVIDER=off

# on | off   -> seed the demo login (recruiter@techcorp.com / password123) in local auth mode only
VITE_SEED_DEMO_ACCOUNT=on
